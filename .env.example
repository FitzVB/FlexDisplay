# Environment Configuration Template
# Copy this file to .env and customize for your setup

# ============================================
# Host Server Configuration
# ============================================

# Listen address for WebSocket server (USB: 127.0.0.1, Wi-Fi: 0.0.0.0)
FLEXDISPLAY_LISTEN=0.0.0.0

# Listen port (must match ADB reverse setting)
FLEXDISPLAY_PORT=9001

# ============================================
# Video Encoding Parameters
# ============================================

# Target frames per second (10-60) — used when no GUI preset is set
FLEXDISPLAY_FPS=60

# Target bitrate in kbps (1000-50000)
FLEXDISPLAY_BITRATE=10000

# Hardware encoder preference (locks encoder when set via GUI too)
# Options: h264_nvenc, h264_qsv, h264_amf, libx264
# Leave empty for auto-detection with vendor-aware filtering
FLEXDISPLAY_HW_ENCODER=

# Force software encoder (skips all HW encoder probes)
FORCE_SOFTWARE_ENCODER=false

# ============================================
# Screen Capture
# ============================================

# Capture backend override: gdigrab or ddagrab
FLEXDISPLAY_CAPTURE=

# Optional capture/output resolution hints (used when no preset is set)
FLEXDISPLAY_CAPTURE_WIDTH=1920
FLEXDISPLAY_CAPTURE_HEIGHT=1080

# ============================================
# Logging
# ============================================

RUST_LOG=info

# Disable auto-opening host GUI on startup
# FLEXDISPLAY_DISABLE_AUTO_GUI=1
