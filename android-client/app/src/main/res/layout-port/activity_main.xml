<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_root"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/setupScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false">

        <LinearLayout
            android:id="@+id/topPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_top_panel"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/brandLogo"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@string/logo_content_desc"
                    android:src="@drawable/flexdisplay_logo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textColor="@color/fd_white"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/app_subtitle"
                        android:textColor="@color/fd_text_muted"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <Button
                    android:id="@+id/menuButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:backgroundTint="@color/fd_cyan"
                    android:text="@string/btn_menu"
                    android:textColor="@color/fd_white" />

                <Button
                    android:id="@+id/languageButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:backgroundTint="@color/fd_violet"
                    android:text="@string/btn_language"
                    android:textColor="@color/fd_white" />

                <Button
                    android:id="@+id/helpButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/fd_violet"
                    android:text="@string/btn_help"
                    android:textColor="@color/fd_white" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/label_pc_ip"
                android:textColor="@color/fd_white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/serverIpInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:backgroundTint="@color/fd_cyan"
                android:hint="@string/hint_pc_ip"
                android:inputType="textNoSuggestions"
                android:singleLine="true"
                android:text="127.0.0.1"
                android:textColor="@color/fd_white"
                android:textColorHint="@color/fd_text_muted" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/hint_pc_ip_desc"
                android:textColor="@color/fd_text_muted"
                android:textSize="11sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/label_display_mode"
                android:textColor="@color/fd_white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/modeSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:backgroundTint="@color/fd_cyan"
                android:entries="@array/display_modes" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/label_monitor_number"
                android:textColor="@color/fd_white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/displayInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:backgroundTint="@color/fd_cyan"
                android:hint="@string/hint_monitor_auto"
                android:inputType="number"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/fd_white"
                android:textColorHint="@color/fd_text_muted" />

            <Button
                android:id="@+id/connectButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/fd_orange"
                android:text="@string/btn_connect"
                android:textColor="@color/fd_white" />

            <Switch
                android:id="@+id/hudToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:checked="true"
                android:text="@string/label_hud"
                android:textColor="@color/fd_white"
                android:thumbTint="@color/fd_cyan"
                android:trackTint="@color/fd_track" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/status_disconnected"
                android:textColor="@color/fd_text_muted" />
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/streamContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/fd_stream_bg"
        android:visibility="gone">

        <SurfaceView
            android:id="@+id/streamSurface"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/hudText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="@color/fd_hud_bg"
            android:fontFamily="monospace"
            android:padding="4dp"
            android:text=""
            android:textColor="@color/fd_white"
            android:textSize="12sp" />
    </FrameLayout>

    <ScrollView
        android:id="@+id/logScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:background="@color/fd_log_bg">

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Logs..."
            android:textColor="@color/fd_text_dark" />
    </ScrollView>

</LinearLayout>
